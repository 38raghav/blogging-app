<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head.ejs') %>
        <title>Add Blog</title>
</head>

<body>
    <%- include("./partials/nav.ejs") %>
    <%- include("./partials/flash.ejs") %>
        <form class="container mt-5 col-10 col-md-6 mx-auto"  action="/blog/new" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="image" class="form-label">Upload Image Url</label>
                <input type="file" class="form-control" id="image" name="image" required>
            </div>
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" class="form-control" id="title" name="title" required>
            </div>
            <div class="form-floating mb-3">
                <textarea class="form-control" placeholder="Write your blog content here" name="content" id="textArea" style="height: 100px" required></textarea>
                <label for="textArea">Description</label>
            </div>
            <button type="submit" class="btn btn-primary">Publish Blog</button>
        </form>
        <%- include('./partials/footer.ejs') %>
</body>

</html>