<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head.ejs') %>
        <title>Home Page</title>
</head>

<body>
    <%- include("./partials/nav.ejs") %>
        <%- include("./partials/flash.ejs") %>
            <h4 class="text-center">All Blogs</h4>
            <div class="container">
                <div class="row">
                    <% blogs.forEach((blog)=> { %>
                        <div class="col-12 col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <img src="<%= blog.image?.url %>" class="card-img-top"  style="height: 220px; object-fit: cover;" alt="Blog Image">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <%= blog.title %>
                                    </h5>
                                    
                                    <a href="/blog/<%=blog._id %>" class="btn btn-primary">see</a>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
                
            </div>
            <%- include('./partials/footer.ejs') %>
</body>

</html>