<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head.ejs') %>
        <title>Edit Blog</title>
</head>

<body>
    <%- include("./partials/nav.ejs") %>
    <%- include("./partials/flash.ejs") %>
        <form class="container mt-5 col-10 col-md-6 mx-auto"  action="/blog/<%=blog._id%>?_method=PUT" method="POST">
            <div class="mb-3">
                <label for="image" class="form-label">Upload Image Url</label>
                <input type="text" value="<%=blog.image.url %>" class="form-control" id="image" name="coverimage">
            </div>
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" value="<%=blog.title %>" class="form-control" id="title" name="title">
            </div>
            <div class="form-floating mb-3">
                <textarea class="form-control"  placeholder="Write your blog content here" name="content" id="textArea" style="height: 100px"><%= blog.description %></textarea>
                <label for="textArea">Description</label>
            </div>
            <button type="submit" class="btn btn-primary">Update Blog</button>
        </form>
        <%- include('./partials/footer.ejs') %>
</body>

</html>